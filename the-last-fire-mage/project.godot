[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="chickens"
3d_physics/layer_4="interact"
3d_physics/layer_5="props"
3d_physics/layer_6="hitboxes"
3d_physics/layer_7="triggers"
3d_physics/layer_8="spectator"
