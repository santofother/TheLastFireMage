class_name SoundBank
extends Resource
## Cue name -> AudioStream table. Owner: S18. NET: local audio only.
## `sound_bank.tres` is GENERATED by `tools/audio/build_bank.py` from `docs/audio/CUE_SHEET.md`; don't hand-edit it.
## Public API: `streams`, `loops`, `placeholder_cues`, `has_cue(cue)`, `get_stream(cue)`, `cue_names()`.

## StringName cue -> AudioStream (AudioStreamRandomizer when a cue has several takes).
@export var streams: Dictionary = {}
## Cues that loop. `get_stream()` switches looping on for them (so imports need no per-file settings).
@export var loops: PackedStringArray = PackedStringArray()
## Cues still using a synthesised placeholder (diagnostics; the F3/log line reports the count).
@export var placeholder_cues: PackedStringArray = PackedStringArray()

var _prepared := {}


## True if the bank knows this cue.
func has_cue(cue: StringName) -> bool:
	return streams.has(cue)


## The stream for a cue (null if unknown). Loop cues come back with looping enabled.
func get_stream(cue: StringName) -> AudioStream:
	var s: AudioStream = streams.get(cue)
	if s == null or _prepared.has(cue):
		return s
	_prepared[cue] = true
	if loops.has(String(cue)):
		_make_looping(s)
	return s


## Every cue name in the bank.
func cue_names() -> Array:
	return streams.keys()


static func _make_looping(s: AudioStream) -> void:
	if s is AudioStreamWAV:
		var w := s as AudioStreamWAV
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = int(w.get_length() * float(w.mix_rate))
	elif s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = true
	elif s is AudioStreamMP3:
		(s as AudioStreamMP3).loop = true
