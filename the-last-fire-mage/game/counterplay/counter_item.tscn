[gd_scene format=3]

[ext_resource type="Script" path="res://game/counterplay/counter_item.gd" id="1"]
[ext_resource type="Script" path="res://game/interact/interactable.gd" id="2"]

[sub_resource type="CylinderMesh" id="mesh"]
top_radius = 0.17
bottom_radius = 0.13
height = 0.3

[sub_resource type="SphereShape3D" id="zone"]
radius = 0.5

[sub_resource type="SceneReplicationConfig" id="repl"]
properties/0/path = NodePath(".:position")
properties/0/spawn = true
properties/0/replication_mode = 2
properties/1/path = NodePath(".:state")
properties/1/spawn = true
properties/1/replication_mode = 2
properties/2/path = NodePath(".:carrier_id")
properties/2/spawn = true
properties/2/replication_mode = 2

[node name="CounterItem" type="Node3D"]
script = ExtResource("1")

[node name="Mesh" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.15, 0)
mesh = SubResource("mesh")

[node name="Sync" type="MultiplayerSynchronizer" parent="."]
replication_interval = 0.05
replication_config = SubResource("repl")

[node name="Interactable" type="Area3D" parent="."]
collision_layer = 8
collision_mask = 0
monitoring = false
script = ExtResource("2")
prompt = "Pick up item"
kind = &"item"

[node name="Zone" type="CollisionShape3D" parent="Interactable"]
shape = SubResource("zone")
